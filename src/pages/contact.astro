---
import Base from "~/layouts/Base.astro";
import SectionHeader from "~/components/SectionHeader.astro";
import { site } from "~/data/site.ts";

const dayLabel: Record<string, string> = {
  Mon: "Monday", Tue: "Tuesday", Wed: "Wednesday", Thu: "Thursday",
  Fri: "Friday", Sat: "Saturday", Sun: "Sunday",
};

const fullAddress = `${site.address.street}, ${site.address.city}, ${site.address.region} ${site.address.postal}`;
const mapsEmbed = `https://www.google.com/maps?q=${encodeURIComponent(fullAddress)}&output=embed`;
const mapsDirections = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(fullAddress)}`;
---

<Base
  title="Contact"
  path="/contact/"
  description="Schedule a free estimate, get directions, or call Phil's Collision Center in Schererville, IN."
>
  <section class="container-page pt-16 md:pt-24 pb-12 md:pb-20">
    <SectionHeader
      eyebrow="Contact"
      title="Bring it in. Or just call."
      deck="Estimates are free and don't need an appointment. The phone goes straight to the shop."
    />
  </section>

  <section class="container-page pb-20 md:pb-28 grid lg:grid-cols-12 gap-10 lg:gap-16">
    <!-- Estimate form -->
    <div class="lg:col-span-7">
      <!--
        Netlify Forms — the `data-netlify` attribute is detected during build,
        no JS, no third-party. Submissions land in Netlify dashboard + email.
      -->
      <form
        name="estimate"
        method="POST"
        action="/thank-you/"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="rounded-2xl border border-[var(--color-ink-edge)] bg-[var(--color-ink-elev)] p-7 md:p-10 flex flex-col gap-5"
      >
        <input type="hidden" name="form-name" value="estimate" />
        <p hidden>
          <label>Leave this empty: <input name="bot-field" /></label>
        </p>

        <h2 class="font-display text-3xl text-[var(--color-bone)]">Request a free estimate</h2>

        <div class="grid sm:grid-cols-2 gap-5">
          <label class="flex flex-col gap-1.5 text-sm text-[var(--color-bone-muted)]">
            Your name
            <input
              type="text"
              name="name"
              required
              class="bg-[var(--color-ink)] border border-[var(--color-ink-edge)] focus:border-[var(--color-spark-500)] rounded-lg px-3 py-2.5 text-[var(--color-bone)] outline-none"
            />
          </label>
          <label class="flex flex-col gap-1.5 text-sm text-[var(--color-bone-muted)]">
            Phone
            <input
              type="tel"
              name="phone"
              required
              autocomplete="tel"
              class="bg-[var(--color-ink)] border border-[var(--color-ink-edge)] focus:border-[var(--color-spark-500)] rounded-lg px-3 py-2.5 text-[var(--color-bone)] outline-none"
            />
          </label>
          <label class="flex flex-col gap-1.5 text-sm text-[var(--color-bone-muted)] sm:col-span-2">
            Email
            <input
              type="email"
              name="email"
              autocomplete="email"
              class="bg-[var(--color-ink)] border border-[var(--color-ink-edge)] focus:border-[var(--color-spark-500)] rounded-lg px-3 py-2.5 text-[var(--color-bone)] outline-none"
            />
          </label>
          <label class="flex flex-col gap-1.5 text-sm text-[var(--color-bone-muted)]">
            Vehicle year, make, model
            <input
              type="text"
              name="vehicle"
              placeholder="2018 Chevrolet Equinox"
              class="bg-[var(--color-ink)] border border-[var(--color-ink-edge)] focus:border-[var(--color-spark-500)] rounded-lg px-3 py-2.5 text-[var(--color-bone)] outline-none"
            />
          </label>
          <label class="flex flex-col gap-1.5 text-sm text-[var(--color-bone-muted)]">
            Insurance (optional)
            <input
              type="text"
              name="insurance"
              placeholder="State Farm"
              class="bg-[var(--color-ink)] border border-[var(--color-ink-edge)] focus:border-[var(--color-spark-500)] rounded-lg px-3 py-2.5 text-[var(--color-bone)] outline-none"
            />
          </label>
          <label class="flex flex-col gap-1.5 text-sm text-[var(--color-bone-muted)] sm:col-span-2">
            What happened? (and where on the vehicle)
            <textarea
              name="message"
              rows="4"
              class="bg-[var(--color-ink)] border border-[var(--color-ink-edge)] focus:border-[var(--color-spark-500)] rounded-lg px-3 py-2.5 text-[var(--color-bone)] outline-none resize-y"
            ></textarea>
          </label>
        </div>

        <button
          type="submit"
          class="self-start inline-flex items-center gap-2 bg-[var(--color-spark-500)] hover:bg-[var(--color-spark-600)] text-[var(--color-bone)] px-6 py-3 rounded-full font-medium transition-colors"
        >
          Send request
          <span aria-hidden="true">→</span>
        </button>
        <p class="text-xs text-[var(--color-bone-dim)]">
          We typically respond the same business day. For faster service, call us directly.
        </p>
      </form>
    </div>

    <!-- Sidebar: address, phone, hours, map -->
    <aside class="lg:col-span-5 flex flex-col gap-8">
      <div>
        <h2 class="text-xs uppercase tracking-widest text-[var(--color-bone-dim)] mb-3">Visit</h2>
        <address class="not-italic text-2xl text-[var(--color-bone)] leading-snug font-editorial">
          {site.address.street}<br />
          {site.address.city}, {site.address.region} {site.address.postal}
        </address>
        <a
          href={mapsDirections}
          target="_blank"
          rel="noopener"
          class="inline-block mt-3 text-sm text-[var(--color-spark-400)] hover:text-[var(--color-spark-500)] underline underline-offset-4"
        >
          Directions on Google →
        </a>
      </div>

      <div>
        <h2 class="text-xs uppercase tracking-widest text-[var(--color-bone-dim)] mb-3">Call</h2>
        <a
          href={`tel:${site.phone.tel}`}
          class="font-display text-4xl md:text-5xl text-[var(--color-bone)] hover:text-[var(--color-spark-400)] transition-colors leading-none"
        >
          {site.phone.display}
        </a>
      </div>

      <div>
        <h2 class="text-xs uppercase tracking-widest text-[var(--color-bone-dim)] mb-3">Hours</h2>
        <dl class="text-sm rounded-xl border border-[var(--color-ink-edge)] divide-y divide-[var(--color-ink-edge)]">
          {site.hours.map((h) => (
            <div class="flex justify-between px-4 py-2.5">
              <dt class="text-[var(--color-bone-muted)]">{dayLabel[h.day]}</dt>
              <dd class="text-[var(--color-bone)] tabular-nums">
                {h.open && h.close ? `${h.open}–${h.close}` : "Closed"}
              </dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="rounded-2xl overflow-hidden border border-[var(--color-ink-edge)] aspect-[4/3]">
        <iframe
          src={mapsEmbed}
          title={`Map of ${site.name}, ${fullAddress}`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="w-full h-full"
        />
      </div>
    </aside>
  </section>
</Base>
