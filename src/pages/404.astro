---
import Base from "~/layouts/Base.astro";
import { site } from "~/data/site.ts";
---

<Base title="Page not found" path="/404/" description="That page doesn't exist.">
  <section class="container-page py-32 md:py-48 text-center flex flex-col items-center gap-6 max-w-2xl mx-auto">
    <p class="font-display text-8xl md:text-9xl text-[var(--color-spark-500)] leading-none">404</p>
    <h1 class="font-display text-[var(--text-display-lg)] text-[var(--color-bone)] leading-[0.95]">
      Wrong turn.
    </h1>
    <p class="font-editorial text-2xl text-[var(--color-bone-muted)] leading-snug">
      The page you're looking for isn't here. Try the homepage, or give us a call.
    </p>
    <div class="flex flex-col sm:flex-row gap-3 mt-4">
      <a href="/" class="inline-flex items-center gap-2 bg-[var(--color-spark-500)] hover:bg-[var(--color-spark-600)] text-[var(--color-bone)] px-6 py-3.5 rounded-full font-medium">
        Back to home
      </a>
      <a href={`tel:${site.phone.tel}`} class="inline-flex items-center gap-2 border border-[var(--color-ink-edge)] hover:border-[var(--color-bone-muted)] text-[var(--color-bone)] px-6 py-3.5 rounded-full font-medium">
        {site.phone.display}
      </a>
    </div>
  </section>
</Base>
