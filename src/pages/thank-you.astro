---
import Base from "~/layouts/Base.astro";
import { site } from "~/data/site.ts";
---

<Base
  title="Thanks"
  path="/thank-you/"
  description="Your estimate request was received. We'll respond the same business day."
>
  <section class="container-page py-24 md:py-32 max-w-2xl mx-auto text-center flex flex-col items-center gap-6">
    <div class="flex items-center justify-center w-20 h-20 rounded-full bg-[var(--color-spark-500)]/15 text-[var(--color-spark-500)]">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="20 6 9 17 4 12"/>
      </svg>
    </div>
    <p class="text-xs uppercase tracking-[0.3em] text-[var(--color-spark-500)] font-medium">Got it</p>
    <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-[var(--color-bone)] leading-[0.95]">
      Thanks — we'll be in touch.
    </h1>
    <p class="font-editorial text-xl md:text-2xl text-[var(--color-bone-muted)] leading-snug">
      Your estimate request landed. We typically respond the same business day. If you need us right now, give us a call.
    </p>
    <div class="flex flex-wrap gap-3 justify-center mt-4">
      <a
        href={`tel:${site.phone.tel}`}
        class="inline-flex items-center gap-2 bg-[var(--color-spark-500)] hover:bg-[var(--color-spark-600)] text-[var(--color-bone)] px-6 py-3.5 rounded-full font-medium transition-colors"
      >
        {site.phone.display}
      </a>
      <a
        href="/"
        class="inline-flex items-center gap-2 border border-[var(--color-ink-edge)] hover:border-[var(--color-bone-muted)] text-[var(--color-bone)] px-6 py-3.5 rounded-full font-medium transition-colors"
      >
        Back to home
      </a>
    </div>
  </section>
</Base>
