  <style>
    .testimonial-slide,
    .testimonial-quote {
      opacity: 0;
      pointer-events: none;
    }
    .testimonial-slide.is-active,
    .testimonial-quote.is-active {
      opacity: 1;
      pointer-events: auto;
    }
    .testimonial-dot {
      background: rgba(245, 243, 239, 0.25);
    }
    .testimonial-dot:hover {
      background: rgba(245, 243, 239, 0.6);
    }
    .testimonial-dot.is-active {
      background: var(--color-spark-500);
      width: 1.75rem;
    }
  </style>

  <script>
    const section = document.getElementById("testimonials");
    if (section) {
      const slides = Array.from(section.querySelectorAll<HTMLElement>(".testimonial-slide"));
      const quotes = Array.from(section.querySelectorAll<HTMLElement>(".testimonial-quote"));
      const dots = Array.from(section.querySelectorAll<HTMLButtonElement>(".testimonial-dot"));
      const toggle = section.querySelector<HTMLButtonElement>("#testimonials-toggle");
      const playIcon = toggle?.querySelector<HTMLElement>(".t-icon-play");
      const pauseIcon = toggle?.querySelector<HTMLElement>(".t-icon-pause");

      let current = 0;
      let timer: number | undefined;
      let playing = true;
      const INTERVAL = 6000;

      const show = (idx: number) => {
        slides.forEach((s, i) => s.classList.toggle("is-active", i === idx));
        quotes.forEach((q, i) => q.classList.toggle("is-active", i === idx));
        dots.forEach((d, i) => d.classList.toggle("is-active", i === idx));
        current = idx;
      };
      const next = () => show((current + 1) % slides.length);

      const start = () => {
        window.clearInterval(timer);
        timer = window.setInterval(next, INTERVAL);
      };
      const stop = () => window.clearInterval(timer);

      dots.forEach((dot, i) => {
        dot.addEventListener("click", () => {
          show(i);
          if (playing) start();
        });
      });

      toggle?.addEventListener("click", () => {
        playing = !playing;
        if (playing) {
          start();
          playIcon?.classList.add("hidden");
          pauseIcon?.classList.remove("hidden");
          toggle.setAttribute("aria-label", "Pause testimonial auto-advance");
        } else {
          stop();
          playIcon?.classList.remove("hidden");
          pauseIcon?.classList.add("hidden");
          toggle.setAttribute("aria-label", "Resume testimonial auto-advance");
        }
      });

      // Pause when off-screen, resume when back, courteous + saves CPU.
      // Threshold 0 + a generous rootMargin means we start playing slightly
      // before the section is fully on-screen, so it's never caught "stuck"
      // when the user lands on it.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!playing) continue;
            if (e.isIntersecting) start();
            else stop();
          }
        },
        { threshold: 0, rootMargin: "0px 0px -10% 0px" },
      );
      io.observe(section);

      start();
    }
  </script>

