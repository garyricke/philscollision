  <script>
    // Hero plays the list of clips in order. After each clip ends it holds on
    // the final pristine frame for 3s, then advances to the next clip (or
    // loops back to the first).
    const v = document.getElementById("hero-video") as HTMLVideoElement | null;
    if (v) {
      const clips: string[] = JSON.parse(v.dataset.clips ?? "[]");
      const posters: string[] = JSON.parse(v.dataset.posters ?? "[]");
      let idx = 0;
      v.addEventListener("ended", () => {
        window.setTimeout(() => {
          idx = (idx + 1) % clips.length;
          v.src = clips[idx];
          if (posters[idx]) v.poster = posters[idx];
          v.load();
          v.play().catch(() => {});
        }, 3000);
      });
    }
  </script>
