---
import Base from "~/layouts/Base.astro";
import SectionHeader from "~/components/SectionHeader.astro";
import VideoCard from "~/components/VideoCard.astro";
import { videos } from "~/data/videos.ts";
import { site } from "~/data/site.ts";

const aboutVids = ["eds-story", "ivan-master-painter", "ward"]
  .map((slug) => videos.find((v) => v.slug === slug)!)
  .filter(Boolean);

const milestones = [
  { year: "1981", text: "Ed graduates from a vocational-tech program in Illinois and starts in the family's auto body shop." },
  { year: "2000", text: "Family business moves to Florida; Ed eventually takes the reins." },
  { year: "2014", text: "Family relocates back to Indiana to be near grandchildren. They acquire Phil's Collision Center in Schererville." },
  { year: "Today", text: "Ranked #1 in local Google reviews. Combined team experience over 150 years. State Farm DRP partner." },
  { year: "2028", text: "Succession plan: Eddie Jr. takes over." },
];

const values = [
  { title: "Family first", body: "Customers, staff, suppliers — we treat the people in this building like family. It's not a slogan; it's why people come back." },
  { title: "Right the first time", body: "We follow manufacturer repair procedures. We don't cut corners for the insurance company or the schedule." },
  { title: "Tell you the truth", body: "Whatever the timeline is, that's what we tell you. When it changes, we tell you that too." },
  { title: "Invest in the next generation", body: "I-CAR training for young techs. The shop on Sundays for personal projects. Parts at cost. The trade only continues if we teach it." },
];
---

<Base
  title="About"
  path="/about/"
  description="Family-run since 2014, 45+ years of collision experience. Meet Ed Kalinowski and the team at Phil's Collision Center in Schererville, IN."
>
  <section class="container-page pt-16 md:pt-24 pb-12 md:pb-20">
    <SectionHeader
      eyebrow="About"
      title="A 45-year shop, run by a family that's still on the floor."
      deck="Phil's was already a Schererville institution. The Kalinowski family bought it in 2014 and kept it that way."
    />
  </section>

  <!-- Ed & shop story (paraphrased, not reproduced from third-party press) -->
  <section class="container-page pb-20 md:pb-28">
    <div class="grid md:grid-cols-12 gap-10 md:gap-16">
      <div class="md:col-span-7 flex flex-col gap-5 text-lg md:text-xl text-[var(--color-bone-muted)] leading-relaxed max-w-2xl">
        <p>
          Ed Kalinowski grew up ten minutes from his family's auto body shop in Illinois. He went to a vocational-tech program in high school, went into the family business straight after graduation in 1981, and never looked back.
        </p>
        <p>
          In 2000, the family bought a shop in Florida and moved south. By 2014, with the business thriving, Ed's father wanted to come home to see his grandchildren. They sold the Florida shop and acquired a small Schererville body shop with an outsized local reputation: Phil's.
        </p>
        <p class="font-editorial text-2xl text-[var(--color-bone)] leading-snug border-l-2 border-[var(--color-spark-500)] pl-5">
          A decade in, the shop ranks #1 in local Google reviews. The team has 150+ combined years on the floor. Ed plans to hand the keys to his son, Eddie Jr., by 2028 — and to keep showing up to help.
        </p>
      </div>

      <div class="md:col-span-5">
        <div class="max-w-xs lg:ml-auto lg:mr-0">
          <VideoCard video={aboutVids[0]} />
        </div>
      </div>
    </div>
  </section>

  <!-- Milestones -->
  <section class="border-y border-[var(--color-ink-edge)] bg-[var(--color-ink-elev)] py-20 md:py-28">
    <div class="container-page">
      <SectionHeader eyebrow="Timeline" title="Forty-five years, in five stops." />
      <ol class="flex flex-col">
        {milestones.map((m) => (
          <li class="grid grid-cols-[8rem_1fr] md:grid-cols-[12rem_1fr] gap-6 py-6 border-t border-[var(--color-ink-edge)] last:border-b">
            <span class="font-display text-3xl md:text-4xl text-[var(--color-spark-500)]">{m.year}</span>
            <p class="text-lg text-[var(--color-bone)] leading-snug self-center">{m.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Values -->
  <section class="container-page py-20 md:py-28">
    <SectionHeader eyebrow="What we believe" title="Four things we don't compromise on." />
    <div class="grid sm:grid-cols-2 gap-px bg-[var(--color-ink-edge)] border border-[var(--color-ink-edge)] rounded-2xl overflow-hidden">
      {values.map((v) => (
        <article class="bg-[var(--color-ink)] p-8 md:p-10 flex flex-col gap-3">
          <h3 class="font-display text-3xl text-[var(--color-bone)]">{v.title}</h3>
          <p class="text-[var(--color-bone-muted)] leading-relaxed">{v.body}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- The team (videos) -->
  <section class="bg-[var(--color-ink-elev)] py-20 md:py-28 border-y border-[var(--color-ink-edge)]">
    <div class="container-page">
      <SectionHeader
        eyebrow="The team"
        title="Two voices from the shop."
        link={{ label: `All ${videos.length} stories`, href: "/stories/" }}
      />
      <div class="grid sm:grid-cols-2 gap-10 max-w-3xl mx-auto">
        <VideoCard video={aboutVids[1]} />
        <VideoCard video={aboutVids[2]} />
      </div>
    </div>
  </section>

  <!-- Press -->
  <section class="container-page py-20 md:py-28">
    <div class="max-w-3xl">
      <p class="text-xs uppercase tracking-[0.3em] text-[var(--color-spark-500)] font-medium mb-4">As featured</p>
      <h2 class="font-display text-[var(--text-display-lg)] text-[var(--color-bone)] leading-[0.95] mb-5">
        FenderBender Magazine
      </h2>
      <p class="font-editorial text-2xl text-[var(--color-bone-muted)] leading-snug mb-6 max-w-2xl">
        The November 2025 issue of FenderBender ran a case study on how Phil's recruits and mentors the next generation of collision techs — including an I-CAR training partnership with the same vocational school Ed attended decades ago.
      </p>
      <a
        href="https://issuu.com/docs/509dd076e0bc3a6a969f6d64d9b2ce6b/38"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 border border-[var(--color-ink-edge)] hover:border-[var(--color-bone-muted)] text-[var(--color-bone)] px-5 py-3 rounded-full text-sm font-medium transition-colors"
      >
        Read the article on Issuu
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>

  <section class="container-page pb-20 md:pb-32">
    <div class="rounded-2xl border border-[var(--color-spark-500)]/30 bg-[var(--color-ink-elev)] p-10 md:p-14 flex flex-col md:flex-row md:items-end justify-between gap-6">
      <h2 class="font-display text-3xl md:text-5xl text-[var(--color-bone)] leading-tight max-w-xl">
        Come meet the family.
      </h2>
      <div class="flex flex-col sm:flex-row gap-3">
        <a href="/contact/" class="inline-flex items-center justify-center gap-2 bg-[var(--color-spark-500)] hover:bg-[var(--color-spark-600)] text-[var(--color-bone)] px-6 py-3.5 rounded-full font-medium">
          Visit us
        </a>
        <a href={`tel:${site.phone.tel}`} class="inline-flex items-center justify-center gap-2 border border-[var(--color-ink-edge)] hover:border-[var(--color-bone-muted)] text-[var(--color-bone)] px-6 py-3.5 rounded-full font-medium">
          {site.phone.display}
        </a>
      </div>
    </div>
  </section>
</Base>
