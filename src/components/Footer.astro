---
import { footerNav, site } from "~/data/site.ts";

const year = new Date().getFullYear();
const dayLabel: Record<string, string> = {
  Mon: "Monday", Tue: "Tuesday", Wed: "Wednesday", Thu: "Thursday",
  Fri: "Friday", Sat: "Saturday", Sun: "Sunday",
};
---

<footer class="bg-[var(--color-ink-elev)] border-t border-[var(--color-ink-edge)] mt-32">
  <div class="container-page py-16 md:py-20 grid gap-12 md:grid-cols-12">
    <div class="md:col-span-5 flex flex-col gap-4">
      <a href="/" class="font-display text-3xl text-[var(--color-bone)] leading-none">
        Phil's<span class="text-[var(--color-spark-500)]">.</span>
        <span class="font-sans text-base font-normal text-[var(--color-bone-muted)] ml-2 tracking-normal">
          Collision Center
        </span>
      </a>
      <p class="font-editorial text-2xl text-[var(--color-bone-muted)] max-w-md leading-snug">
        Transforming accidents into masterpieces — for 45 years, in Schererville, Indiana.
      </p>
      <div class="flex gap-2 mt-2 flex-wrap">
        {site.certifications.map((c) => (
          <span class="text-xs uppercase tracking-widest border border-[var(--color-ink-edge)] text-[var(--color-bone-muted)] px-2.5 py-1 rounded">
            {c.name}
          </span>
        ))}
      </div>
    </div>

    <div class="md:col-span-3">
      <h2 class="text-xs uppercase tracking-widest text-[var(--color-bone-dim)] mb-4">Visit</h2>
      <address class="not-italic text-[var(--color-bone)] leading-relaxed">
        {site.address.street}<br />
        {site.address.city}, {site.address.region} {site.address.postal}
      </address>
      <a
        href={`tel:${site.phone.tel}`}
        class="block mt-3 text-[var(--color-bone)] hover:text-[var(--color-spark-400)] transition-colors"
      >
        {site.phone.display}
      </a>
      <a
        href={site.social.google}
        target="_blank"
        rel="noopener"
        class="inline-block mt-3 text-sm text-[var(--color-bone-muted)] underline underline-offset-4 decoration-[var(--color-ink-edge)] hover:text-[var(--color-bone)] hover:decoration-[var(--color-spark-400)] transition-colors"
      >
        Directions on Google →
      </a>
    </div>

    <div class="md:col-span-2">
      <h2 class="text-xs uppercase tracking-widest text-[var(--color-bone-dim)] mb-4">Hours</h2>
      <dl class="text-sm">
        {site.hours.map((h) => (
          <div class="flex justify-between py-1 border-b border-dotted border-[var(--color-ink-edge)] last:border-0">
            <dt class="text-[var(--color-bone-muted)]">{dayLabel[h.day]}</dt>
            <dd class="text-[var(--color-bone)] tabular-nums">
              {h.open && h.close ? `${h.open}–${h.close}` : "Closed"}
            </dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="md:col-span-2">
      <h2 class="text-xs uppercase tracking-widest text-[var(--color-bone-dim)] mb-4">Site</h2>
      <ul class="flex flex-col gap-2 text-sm">
        {footerNav.map((item) => (
          <li>
            <a href={item.href} class="text-[var(--color-bone-muted)] hover:text-[var(--color-bone)] transition-colors">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="border-t border-[var(--color-ink-edge)]">
    <div class="container-page py-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs text-[var(--color-bone-dim)]">
      <p>© {year} {site.name}. All rights reserved.</p>
      <p>
        I-CAR certified · State Farm DRP · Lifetime workmanship warranty
      </p>
    </div>
  </div>
</footer>
