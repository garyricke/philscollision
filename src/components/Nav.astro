---
import { primaryNav, site } from "~/data/site.ts";
import { cld, cldSrcSet } from "~/data/cloudinary.ts";

const current = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? current === "/" : current.startsWith(href);
---

<header class="sticky top-0 z-40 bg-[var(--color-ink)]/85 backdrop-blur-md border-b border-[var(--color-ink-edge)]">
  <div class="container-page flex items-center justify-between gap-6 h-16 md:h-20">
    <a href="/" class="flex items-center" aria-label={`${site.name} — home`}>
      <img
        src={cld("logo", 240)}
        srcset={cldSrcSet("logo", [160, 240, 320])}
        sizes="(min-width: 768px) 160px, 120px"
        alt={site.name}
        height="64"
        class="h-10 md:h-14 w-auto"
        loading="eager"
        decoding="async"
      />
    </a>

    <!-- Desktop nav -->
    <nav aria-label="Primary" class="hidden md:flex items-center gap-7">
      {primaryNav.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? "page" : undefined}
          class:list={[
            "text-sm font-medium tracking-wide transition-colors",
            isActive(item.href)
              ? "text-[var(--color-bone)]"
              : "text-[var(--color-bone-muted)] hover:text-[var(--color-bone)]",
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={`tel:${site.phone.tel}`}
        class="hidden sm:inline-flex items-center gap-2 text-sm font-medium text-[var(--color-bone)] hover:text-[var(--color-spark-400)] transition-colors"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.94.36 1.86.7 2.73a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.35-1.35a2 2 0 0 1 2.11-.45c.87.34 1.79.57 2.73.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        {site.phone.display}
      </a>
      <a
        href="/contact/"
        class="hidden md:inline-flex items-center gap-2 bg-[var(--color-spark-500)] hover:bg-[var(--color-spark-600)] text-[var(--color-bone)] px-4 py-2 rounded-full text-sm font-medium transition-colors"
      >
        Free estimate
        <span aria-hidden="true">→</span>
      </a>

      <!-- Mobile menu button — controlled by the inline script below -->
      <button
        type="button"
        id="nav-toggle"
        aria-controls="nav-mobile"
        aria-expanded="false"
        class="md:hidden inline-flex items-center justify-center w-10 h-10 -mr-2 text-[var(--color-bone)]"
      >
        <span class="sr-only">Toggle menu</span>
        <svg id="nav-icon-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="3" y1="7" x2="21" y2="7"/>
          <line x1="3" y1="17" x2="21" y2="17"/>
        </svg>
        <svg id="nav-icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" class="hidden">
          <line x1="5" y1="5" x2="19" y2="19"/>
          <line x1="19" y1="5" x2="5" y2="19"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div
    id="nav-mobile"
    hidden
    class="md:hidden border-t border-[var(--color-ink-edge)] bg-[var(--color-ink-elev)]"
  >
    <nav aria-label="Mobile" class="container-page py-4 flex flex-col">
      {primaryNav.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? "page" : undefined}
          class:list={[
            "py-3 text-lg font-medium border-b border-[var(--color-ink-edge)] last:border-0",
            isActive(item.href)
              ? "text-[var(--color-bone)]"
              : "text-[var(--color-bone-muted)]",
          ]}
        >
          {item.label}
        </a>
      ))}
      <a
        href="/contact/"
        class="mt-5 inline-flex justify-center items-center bg-[var(--color-spark-500)] text-[var(--color-bone)] px-4 py-3 rounded-full font-medium"
      >
        Free estimate
      </a>
    </nav>
  </div>
</header>

<script>
  // Tiny progressive enhancement — keeps menu state out of any framework.
  const btn = document.getElementById("nav-toggle");
  const drawer = document.getElementById("nav-mobile");
  const iOpen = document.getElementById("nav-icon-open");
  const iClose = document.getElementById("nav-icon-close");
  if (btn && drawer && iOpen && iClose) {
    btn.addEventListener("click", () => {
      const expanded = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", String(!expanded));
      drawer.hidden = expanded;
      iOpen.classList.toggle("hidden", !expanded);
      iClose.classList.toggle("hidden", expanded);
    });
  }
</script>
