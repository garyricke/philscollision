---
import { vimeoThumbnailUrl } from "~/data/videos.ts";

export interface Props {
  vimeoId: string;
  /** Direct 1080p MP4 URL from Vimeo. */
  mp4Url: string;
  /** Used as the iframe/video accessible name. */
  title: string;
  /** Locked aspect for vertical phone-shot videos. Override only if needed. */
  aspect?: "9/16" | "16/9" | "1/1";
  /** Optional VTT caption file in /public/captions/. */
  captions?: string;
  /** When true, the poster gradient is muted so the play button reads cleanly. */
  showOverlay?: boolean;
}

const {
  vimeoId,
  mp4Url,
  title,
  aspect = "9/16",
  captions,
  showOverlay = true,
} = Astro.props;

const thumb = vimeoThumbnailUrl(vimeoId);
---

<!--
  Native-video facade.

  Renders only the poster image until clicked. On click we swap in a `<video>`
  element with the direct MP4 source and our VTT captions wired as a `<track>`.
  Browser handles playback, controls, picture-in-picture, and caption rendering
  with zero JS framework involved. No Vimeo player chrome, no Vimeo SDK loaded.
-->
<div
  class="video-facade group relative w-full overflow-hidden rounded-2xl bg-[var(--color-ink-elev)]"
  style={`aspect-ratio: ${aspect};`}
  data-mp4={mp4Url}
  data-poster={thumb}
  data-title={title}
>
  <button
    type="button"
    class="absolute inset-0 w-full h-full cursor-pointer"
    aria-label={`Play video: ${title}`}
  >
    <img
      src={thumb}
      alt=""
      loading="lazy"
      decoding="async"
      class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
    />
    {showOverlay && (
      <span
        class="absolute inset-0 bg-gradient-to-t from-black/65 via-black/15 to-black/15"
        aria-hidden="true"
      />
    )}
    <span
      class="absolute inset-0 flex items-center justify-center"
      aria-hidden="true"
    >
      <span class="flex items-center justify-center w-16 h-16 md:w-20 md:h-20 rounded-full border-2 border-[var(--color-bone)] text-[var(--color-bone)] backdrop-blur-[1px] shadow-2xl transition-transform duration-300 group-hover:scale-110 group-hover:bg-[var(--color-bone)]/15">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" class="translate-x-[2px]">
          <path d="M8 5v14l11-7z"/>
        </svg>
      </span>
    </span>
  </button>
</div>

<script>
  // Pause every active story video on the page. Called when another video
  // starts, or when a "videos:stop" event is dispatched (e.g. from a filter
  // pill). The hero loop video is not a .video-facade and is unaffected.
  const pauseAllStoryVideos = () => {
    document
      .querySelectorAll<HTMLVideoElement>(".video-facade video")
      .forEach((v) => {
        if (!v.paused) v.pause();
      });
  };
  document.addEventListener("videos:stop", pauseAllStoryVideos);

  // One delegated listener for every video on the page.
  document.addEventListener("click", (e) => {
    const target = e.target as Element | null;
    const facade = target?.closest(".video-facade") as HTMLElement | null;
    if (!facade || facade.querySelector("video")) return;

    // Stop any other story video that's currently playing.
    pauseAllStoryVideos();

    const mp4 = facade.dataset.mp4;
    const poster = facade.dataset.poster ?? "";
    const title = facade.dataset.title ?? "Video";
    if (!mp4) return;

    const video = document.createElement("video");
    video.className = "absolute inset-0 w-full h-full object-cover bg-black";
    video.controls = true;
    video.autoplay = true;
    video.playsInline = true;
    video.preload = "auto";
    video.poster = poster;
    video.setAttribute("aria-label", title);

    const source = document.createElement("source");
    source.src = mp4;
    source.type = "video/mp4";
    video.appendChild(source);

    facade.replaceChildren(video);
    video.play().catch(() => {
      // Some browsers block autoplay-with-sound — `controls` lets the user start it.
    });
  });
</script>
