---
import "~/styles/global.css";
import { site } from "~/data/site.ts";

export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — Internal · {site.name}</title>
  </head>
  <body class="bg-[var(--color-ink)] text-[var(--color-bone)] min-h-screen flex flex-col">
    <!-- Gate: hides page content until the password is right. Stored in sessionStorage so it persists across internal pages within the same tab. -->
    <div id="gate" class="fixed inset-0 z-50 bg-[var(--color-ink)] flex items-center justify-center p-6">
      <form id="gate-form" class="w-full max-w-sm flex flex-col gap-5 text-center">
        <div class="flex flex-col gap-2 mb-2">
          <p class="text-xs uppercase tracking-[0.3em] text-[var(--color-spark-500)] font-medium">Internal</p>
          <h1 class="font-display text-3xl text-[var(--color-bone)]">Phil's review area</h1>
        </div>
        <label class="flex flex-col gap-2 text-left">
          <span class="text-xs uppercase tracking-widest text-[var(--color-bone-dim)]">Password</span>
          <input
            id="gate-input"
            type="password"
            autocomplete="off"
            autofocus
            class="bg-[var(--color-ink-elev)] border border-[var(--color-ink-edge)] rounded-lg px-4 py-3 text-[var(--color-bone)] focus:border-[var(--color-spark-500)] focus:outline-none"
          />
        </label>
        <p id="gate-error" class="hidden text-sm text-[var(--color-spark-400)]">Wrong password.</p>
        <button
          type="submit"
          class="bg-[var(--color-spark-500)] hover:bg-[var(--color-spark-600)] text-[var(--color-bone)] px-6 py-3 rounded-full font-medium transition-colors"
        >
          Enter
        </button>
        <a href="/" class="text-xs uppercase tracking-widest text-[var(--color-bone-dim)] hover:text-[var(--color-bone-muted)] mt-2">
          ← Back to site
        </a>
      </form>
    </div>

    <main id="internal-content" class="hidden flex-1 container-page py-12 md:py-20">
      <nav class="mb-10 flex items-center justify-between gap-6 text-sm">
        <div class="flex items-center gap-5">
          <a href="/" class="text-[var(--color-bone-muted)] hover:text-[var(--color-bone)] transition-colors">← Site</a>
          <span class="text-[var(--color-ink-edge)]">/</span>
          <a href="/internal/status/" class="text-[var(--color-bone-muted)] hover:text-[var(--color-bone)] transition-colors">Status</a>
          <a href="/internal/gallery-review/" class="text-[var(--color-bone-muted)] hover:text-[var(--color-bone)] transition-colors">Gallery review</a>
        </div>
        <button
          type="button"
          id="gate-logout"
          class="text-xs uppercase tracking-widest text-[var(--color-bone-dim)] hover:text-[var(--color-bone)] transition-colors"
        >
          Sign out
        </button>
      </nav>
      <slot />
    </main>

    <script>
      // Casual client-side gate. The password ships in the JS bundle — treat as
      // obscurity not security. Set sessionStorage on success so other internal
      // pages don't re-prompt within the same tab.
      const KEY = "phils-internal-auth";
      const PASS = "edrulz";
      const gate = document.getElementById("gate")!;
      const main = document.getElementById("internal-content")!;
      const form = document.getElementById("gate-form") as HTMLFormElement;
      const input = document.getElementById("gate-input") as HTMLInputElement;
      const errorEl = document.getElementById("gate-error")!;
      const logout = document.getElementById("gate-logout");

      const unlock = () => {
        gate.classList.add("hidden");
        main.classList.remove("hidden");
      };

      if (sessionStorage.getItem(KEY) === "ok") {
        unlock();
      }

      form.addEventListener("submit", (e) => {
        e.preventDefault();
        if (input.value === PASS) {
          sessionStorage.setItem(KEY, "ok");
          errorEl.classList.add("hidden");
          unlock();
        } else {
          errorEl.classList.remove("hidden");
          input.select();
        }
      });

      logout?.addEventListener("click", () => {
        sessionStorage.removeItem(KEY);
        main.classList.add("hidden");
        gate.classList.remove("hidden");
        input.value = "";
        input.focus();
      });
    </script>
  </body>
</html>
