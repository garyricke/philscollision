---
import "~/styles/global.css";
import Nav from "~/components/Nav.astro";
import Footer from "~/components/Footer.astro";
import StickyCallBar from "~/components/StickyCallBar.astro";
import { site } from "~/data/site.ts";

export interface Props {
  /** Page-specific <title> — final form is `${title} — ${site.name}`. */
  title?: string;
  /** Meta description; falls back to site default. */
  description?: string;
  /** Page path including trailing slash (e.g. "/services/"). Used for canonical URL. */
  path: string;
  /** Optional image (absolute or root-relative) for OG/Twitter cards. */
  ogImage?: string;
  /** Optional override of the default LocalBusiness JSON-LD on this page. */
  extraJsonLd?: unknown;
}

const {
  title,
  description = site.description,
  path,
  ogImage = "https://res.cloudinary.com/dsbllwpbh/image/upload/f_auto,q_auto,w_1200/phils-collision/og",
  extraJsonLd,
} = Astro.props;

const fullTitle = title ? `${title} — ${site.name}` : site.name;
const canonical = new URL(path, site.url).toString();
// Absolute URLs pass through; root-relative paths are resolved against the site origin.
const ogImageUrl = ogImage.startsWith("http") ? ogImage : new URL(ogImage, site.url).toString();

// LocalBusiness / AutoBodyShop schema — sits on every page so any URL is a
// valid landing page for local search.
const businessSchema = {
  "@context": "https://schema.org",
  "@type": "AutoBodyShop",
  name: site.name,
  description: site.description,
  url: site.url,
  telephone: site.phone.tel,
  email: site.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    postalCode: site.address.postal,
    addressCountry: site.address.country,
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: site.address.lat,
    longitude: site.address.lng,
  },
  openingHoursSpecification: site.hours
    .filter((h) => h.open && h.close)
    .map((h) => ({
      "@type": "OpeningHoursSpecification",
      dayOfWeek: `https://schema.org/${
        { Mon: "Monday", Tue: "Tuesday", Wed: "Wednesday", Thu: "Thursday", Fri: "Friday", Sat: "Saturday", Sun: "Sunday" }[h.day]
      }`,
      opens: h.open,
      closes: h.close,
    })),
  areaServed: ["Schererville", "Dyer", "Munster", "Highland", "Crown Point", "Northwest Indiana"],
  paymentAccepted: ["Cash", "Credit Card", "Insurance"],
  priceRange: "$$",
};
---

<!doctype html>
<html lang="en" class="grain">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content={site.name} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Theme color matches dark surface so iOS chrome blends in -->
    <meta name="theme-color" content="#0b0b0d" />

    <!-- Favicons (placeholder — swap in real ones later) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts: variable Inter, condensed Anton for display, Instrument Serif italic for editorial pulls. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@300;400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap"
    />

    <!-- Vimeo preconnect — saves a roundtrip when the first video loads. -->
    <link rel="preconnect" href="https://player.vimeo.com" />
    <link rel="dns-prefetch" href="https://i.vimeocdn.com" />

    <!-- LocalBusiness schema -->
    <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
    {extraJsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(extraJsonLd)} />
    )}
  </head>
  <body class="min-h-screen flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:bg-[var(--color-spark-500)] focus:text-[var(--color-bone)] focus:px-3 focus:py-2 focus:rounded"
    >
      Skip to content
    </a>

    <Nav />

    <main id="main" class="flex-1 pb-20 md:pb-0">
      <slot />
    </main>

    <Footer />

    <StickyCallBar />
  </body>
</html>
